# Локально: скопируйте этот файл в booking/agent/.env и впишите значения. Файл .env в Git не попадает.
# В продакшене (Render) те же переменные задаются в панели Render — см. booking/agent/DEPLOY.md.

# --- ИИ ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Telegram: уведомление Марии о каждой новой записи ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Хранилище записей. ЛОКАЛЬНО ОСТАВЬТЕ GITHUB_TOKEN ПУСТЫМ: иначе тестовые записи попадут в боевой приватный репозиторий ---
GITHUB_TOKEN=
BOOKINGS_REPO=rustams060575-bot/ms-nails-bookings

# --- Прочее (необязательно) ---
# PORT=8787
# ALLOWED_ORIGINS=https://msnails.eu,https://www.msnails.eu

# --- WhatsApp Марии о новой записи (Meta Cloud API, необязательно; см. DEPLOY.md, раздел «WhatsApp») ---
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_ID=
# WHATSAPP_MARIA_TO=+306939350160
# WHATSAPP_TEMPLATE_MARIA=new_booking

# --- Кабинет Марии (/admin): паттерны и память гостей. Без токена кабинет выключен ---
# ADMIN_TOKEN=
# MEMORY_DIR=memory

# --- Внешние брони (Treatwell / email / календарь) -> POST /api/external-booking. Секрет для заголовка Authorization: Bearer ... ---
# В продакшене без этого токена эндпоинт выключен; локально открыт без токена.
# EXTERNAL_BOOKING_TOKEN=

# --- Привязка Марии как администратора: POST /api/admin/generate-link (нужен ADMIN_TOKEN) выдаёт одноразовую ссылку t.me/<бот>?start=activate_... ---
# TELEGRAM_BOT_USERNAME=ms_nails_booking_bot
# TELEGRAM_BOT_POLLING=off     # по умолчанию бот слушает /start сам (long polling); off - не слушать (например, если бот уже слушает другой сервер)
# PRINT_ACTIVATION_LINK=true   # печатать ссылку авторизации в лог и в продакшене (по умолчанию только локально)

# --- Почта Афины: фоновый IMAP-опрос писем Treatwell (раз в 60 с; Gmail: нужен «пароль приложения», не обычный пароль) ---
# IMAP_USER=athena.msnails@gmail.com
# IMAP_PASSWORD=
# IMAP_HOST=imap.gmail.com
# IMAP_PORT=993
# IMAP_INTERVAL_SEC=60
# IMAP_FROM=noreply@treatwell.gr
# ATHENA_EMAIL=athena.msnails@gmail.com   # только для вывода в консоль (адрес для Treatwell Connect)
